# App Configuration
APP_NAME=HireLens API
ENVIRONMENT=development
DEBUG=True

# Database (Leave empty or sqlite:///./hirelens.db for local dev; use postgresql+psycopg2://user:password@host:port/dbname for PostgreSQL)
DATABASE_URL=sqlite:///./hirelens.db

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_UPLOAD_SIZE_MB=25

# AI Provider Configuration
# Supported providers: native (default deterministic engine), gemini, openai, anthropic, ollama
AI_PROVIDER=native
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
